    {
      "parameters": {
        "jsCode": "// Sanitização e formatação de telefone para padrão WhatsApp (DDI + DDD + Número)\nconst item = $input.item.json;\nlet rawPhone = String(item.phone || '').replace(/\\D/g, '');\n\nif (rawPhone.startsWith('0')) {\n  rawPhone = rawPhone.substring(1);\n}\nif (!rawPhone.startsWith('55')) {\n  rawPhone = '55' + rawPhone;\n}\n\n// Copy persuasiva adaptada ao nicho\nconst saudacao = `Olá ${item.name}! Tudo bem? ⚡`;\nconst copy = `${saudacao}\\n\\nAqui é a **Artemis**, especialista em soluções digitais da **Infinity On Demand**.\\n\\nVi o trabalho da *${item.business}* e notei que vocês têm grande potencial para aumentar os pedidos diretos e reduzir taxas abusivas de marketplaces.\\n\\nPreparamos uma demonstração exclusiva de 2 minutos do nosso Cardápio e Plataforma Própria.\\n\\nPosso te enviar o link rápido para você dar uma olhada sem compromisso?`;\n\nreturn {\n  json: {\n    ...item,\n    formattedPhone: rawPhone,\n    messageText: copy\n  }\n};"
      },
      "id": "code-format",
      "name": "Formatar Número & Copy Persuasiva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://89.116.74.147:8080/message/sendText/artemis",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "1C257567D7A9-446A-A8DF-A1D7F2536AF6"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.formattedPhone }}\",\n  \"text\": \"{{ $json.messageText }}\",\n  \"delay\": 1200,\n  \"linkPreview\": true\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "http-evolution",
      "name": "Disparar WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
