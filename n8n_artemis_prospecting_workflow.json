        "jsCode": "// Lista inicial de leads para prospecção da Artemis\n// Pode ser substituída por consulta ao Supabase, Apify ou Planilha\nreturn [\n  {\n    json: {\n      name: \"Ricardo\",\n      business: \"Pizzaria Bella\",\n      phone: \"81999990001\",\n      segment: \"Alimentação\"\n    }\n  },\n  {\n    json: {\n      name: \"Camila\",\n      business: \"Boutique Chic\",\n      phone: \"81999990002\",\n      segment: \"Vestuário\"\n    }\n  }\n];"
      },
